@* <p>@server.Name is in @server.City</p> *@

@* 3:50:00 *@
@if (server != null)
{
    <div data-name="@server.Name"
         data-status="Server is @(server.IsOnline ? "online" : "offline")"
         style="color:@(server.IsOnline ? "green" : "red")">
        @server.Name is in @server.City that is @(server.IsOnline ? "online" : "offline")
        &nbsp;
        <button class="btn btn-primary" @onclick="ChangeServerStatus">Turn On/Off</button>
    </div>
}

@code {
    private Server? server = new Server { Name = "Server 1", City = "Toronto" };

    private void ChangeServerStatus()
    {
        if (server != null)
        {
            server.IsOnline = !server.IsOnline;
        }
    }
}

@* @rendermode InteractiveServer

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>City</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var server in servers)
        {
            <tr data-serverServerId="@server.ServerId" @onclick="() => SelectServer(server.ServerId)">
                <td>@server.Name</td>
                <td>@server.City</td>
            </tr>
        }
    </tbody>
</table>

<p>Selected server ServerId: @selectedServerServerId</p>

@code {
    private int selectedServerServerId;

    private List<Server> servers = new()
    {
        new Server { ServerId = 1, Name = "Server 1", City = "Toronto"},
        new Server { ServerId = 2, Name = "Server 2", City = "Berlin"},
        new Server { ServerId = 3, Name = "Server 3", City = "Tokyo"}
    };

    void SelectServer(int ServerId)
    {
        selectedServerServerId = ServerId;
    }
} *@
